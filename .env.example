# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# Port the HTTPS server listens on
PORT=5000

# development | production
NODE_ENV=development

# Secret used to sign JSON Web Tokens.
# Use a long, random, unguessable string (32+ characters) in real deployments.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_before_running

# How long an issued JWT stays valid
JWT_EXPIRES_IN=1h

# Comma-separated list of origins allowed to call this API (frontend URL(s))
CORS_ORIGIN=http://localhost:3000
